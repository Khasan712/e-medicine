# Copy to .env and fill in. Values below are examples only.

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=example.uz,www.example.uz

# DB CONF
DB_ENGINE=postgresql_psycopg2
POSTGRES_DB=medicine
POSTGRES_USER=medicine_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=e_medicine_db
POSTGRES_PORT=5432

# CORS CONF
CORS_ALLOWED_ORIGINS=https://example.uz,https://www.example.uz
CSRF_TRUSTED_ORIGINS=https://example.uz,https://www.example.uz

# --- Customer web shop (/shop/) — website + Telegram Mini App ---
SHOP_NAME=DeliveryHub
# Optional hero headline; a default is shown when empty
SHOP_TAGLINE=
SHOP_SUPPORT_PHONE=+998901234567
SHOP_DELIVERY_TIME=30–45
# Minimum order total in UZS (0 = no minimum)
SHOP_MIN_ORDER=0

# Telegram. BOT_TOKEN is read from bot/.env when it is not set here.
# BOT_TOKEN=
# Optional: resolved automatically with getMe when empty
TELEGRAM_BOT_USERNAME=
# Optional: chat/group id that receives a message about every new web / Mini App order
ORDERS_NOTIFY_CHAT_ID=

# Phone sign-in codes: console (codes go to the server log) | eskiz | telegram_gateway
SMS_BACKEND=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_MESSAGE={shop}: tasdiqlash kodi {code}
TELEGRAM_GATEWAY_TOKEN=
# Local development only — shows the sign-in code in the UI. Never enable in production.
SHOP_OTP_DEBUG=False

# --- Voice / AI order entry in the dashboard "Sales" section (Google Gemini API) ---
# Key: https://aistudio.google.com/apikey  (without a key the page still works: typed commands + Chrome speech)
GEMINI_API_KEY=
GEMINI_PARSE_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy (503) or rate-limited
GEMINI_PARSE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_LIVE_ENABLED=True

# bot/.env additionally needs:
#   BOT_TOKEN=...
#   WEBAPP_URL=https://example.uz/shop/   (HTTPS; enables the Mini App menu button and the "Open shop" button)
