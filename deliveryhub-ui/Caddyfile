{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Our panel is never framed (the shop and the admin panel are: Telegram Web opens Mini Apps in an iframe).
		X-Frame-Options DENY
	}

	# Hashed file names: cached for a year; a missing asset is a real 404.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app: deep links get index.html.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
